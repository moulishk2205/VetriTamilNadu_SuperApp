# Web portal image: builds the Vite app and serves it with nginx as a
# non-root user. /api is proxied to the backend service on the same origin.
# ---------- build stage ----------
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# Same-origin API through the nginx proxy; MSW mock backend off.
ENV VITE_API_BASE_URL=/api VITE_ENABLE_MSW=false
RUN npm run build

# ---------- runtime stage ----------
# nginx-unprivileged runs as uid 101 and listens on 8080 (no root needed).
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
