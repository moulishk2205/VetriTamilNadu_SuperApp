# ─────────────────────────────────────────────────────────────────────────
# Vetri TN — frontend runtime configuration (Vite)
#
# DEFAULT: the app talks to the real NestJS backend. Copy this to `.env.local`.
#
#   VITE_API_URL=http://localhost:4000     # backend origin (routes are under /api)
#   VITE_ENABLE_MSW=false                  # MSW mock backend OFF (default)
#
# To run FULLY OFFLINE against the in-browser MSW mocks (no backend needed):
#   VITE_ENABLE_MSW=true
#
# The seam lives in src/config/env.ts — no component or API-layer code changes.
# ─────────────────────────────────────────────────────────────────────────

# Backend origin. Requests resolve to <VITE_API_URL>/api/*.
VITE_API_URL=http://localhost:4000

# MSW mock backend. Off by default; set to `true` to run offline on mocks.
VITE_ENABLE_MSW=false

# Advanced overrides (optional)
# VITE_API_BASE_URL=/api            # override the resolved base directly
# VITE_REQUEST_TIMEOUT_MS=15000
# VITE_MAX_RETRIES=2
