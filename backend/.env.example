# VETRI API settings. Copy this file to `.env` in this folder and change the
# three secrets below. Docker Compose reads it automatically.
#
#   macOS / Linux:  cp .env.example .env
#   Windows:        copy .env.example .env
#
# Postgres keeps the first password it starts with, so set it once.
# Use letters, digits, - and _ only (it goes into a database URL).
POSTGRES_PASSWORD=change-me-postgres-password
REDIS_PASSWORD=change-me-redis-password

# At least 32 random characters. Generate one with:  openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-to-at-least-32-random-characters

# Demo switches. Keep both false on a real deployment.
#   AUTH_MOCK=true     sign in with any mobile number and OTP 123456, plus
#                      the one-click demo personas at /demo
#   SEED_ON_BOOT=true  fill an empty database with demo data on first start
AUTH_MOCK=true
SEED_ON_BOOT=true

# Only when running the API from source (npm run start:dev) instead of Docker.
# Start Postgres first: docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d postgres
# DATABASE_URL=postgresql://vetri:change-me-postgres-password@localhost:5432/vetri?schema=public

# Proxy hops to trust for client addresses: 1 behind the web portal, 2 when a
# public tunnel sits in front of it.
# TRUST_PROXY=1
